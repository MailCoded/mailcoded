<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Mailcoded.Protocol</RootNamespace>
    <!-- The XML summaries become the JSDoc of the generated TypeScript (tools/Mailcoded.Protocol.TypeScript). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
    Deliberately no PackageReference and no ProjectReference. A client author should be able to
    take this assembly alone and talk to the daemon; if it ever grows a dependency on the engine,
    docs/rpc.md stops being implementable by anyone outside this repository.
  -->
</Project>
